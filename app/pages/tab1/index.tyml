<view class="page" style="height: {{pageHeight}}px;">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="topbar-row">
      <view class="top-btn" bind:tap="goHome">
        <view class="back"></view>
      </view>
      <view class="top-title">Wellness USA</view>
      <view class="top-btn"></view>
    </view>
  </view>

  <scroll-view scroll-y="{{true}}" class="page-body" style="height: {{pageBodyHeight}}px;">
  <view wx:if="{{navTab === 'sauna'}}">
  <view class="gauge-wrap">
    <view class="gauge">
      <view class="ring-track">
        <view class="ring-hole"></view>
      </view>
      <view class="ring-fill" style="{{ringStyle}}">
        <view class="ring-hole"></view>
      </view>
      <view wx:for="{{gaugeTicks}}" wx:key="key" class="g-tick-arm" style="transform: rotate({{item.deg}}deg);">
        <view class="{{item.tickClass}}"></view>
      </view>
      <view wx:for="{{gaugeMarks}}" wx:key="key" class="g-tick-arm" style="transform: rotate({{item.deg}}deg);">
        <view class="g-num" style="transform: rotate({{item.rot}}deg);">{{item.label}}</view>
      </view>
      <view class="arm" style="transform: rotate({{knobDeg}}deg);">
        <view class="g-tick g-tick-now"></view>
        <view class="gauge-knob"></view>
      </view>
      <view class="core">
        <text class="target-lab">Current</text>
        <view class="target-line">
          <text class="temp-num">{{gaugeTemp}}</text>
          <text class="temp-unit">{{unitMark}}</text>
        </view>
        <view class="seg">
          <view class="{{cSegClass}}" catch:tap="setUnitC">C</view>
          <view class="{{fSegClass}}" catch:tap="setUnitF">F</view>
        </view>
      </view>
    </view>
    <view class="heater-dock">
      <view class="light-item-name">Heater</view>
      <view class="{{heaterClass}}" bind:tap="toggleHeater">
        <view class="io-thumb"></view>
        <view class="io-off-lab">OFF</view>
        <view class="io-on-lab">ON</view>
      </view>
    </view>
  </view>

  <view class="{{adjustPanelClass}}">
      <view class="{{tempBlockClass}}">
        <view class="adjust-head">
          <view class="adjust-name">Set temperature</view>
          <view class="adj-value">{{targetDisplay}}</view>
        </view>
        <slider
          min="{{tempMin}}"
          max="{{tempMax}}"
          step="1"
          value="{{tempSlider}}"
          activeColor="#e31b23"
          backgroundColor="#1a3a52"
          block-size="28"
          disabled="{{tempDisabled}}"
          bind:changing="onTempSlide"
          bind:change="onTempSlide"
        />
      </view>
      <view class="{{tempBlockClass}}">
        <view class="adjust-head">
          <view class="adjust-name">Adjust session timer</view>
          <view class="{{timerCapClass}}">{{timerLabel}}</view>
        </view>
        <slider
          min="10"
          max="91"
          step="1"
          value="{{timerSlider}}"
          activeColor="#7ec8e3"
          backgroundColor="#1a3a52"
          block-size="28"
          disabled="{{tempDisabled}}"
          bind:changing="onTimerSlide"
          bind:change="onTimerSlide"
        />
      </view>
  </view>

  <view class="light-panel">
    <view class="light-item">
      <view class="light-item-name">Salt Lights</view>
      <view class="{{saltSwitchClass}}" bind:tap="toggleSalt">
        <view class="io-thumb"></view>
        <view class="io-off-lab">OFF</view>
        <view class="io-on-lab">ON</view>
      </view>
    </view>
    <view class="light-item">
      <view class="light-item-name">Color Lights</view>
      <view class="{{ledToggleClass}}" bind:tap="toggleLed">
        <view class="io-thumb"></view>
        <view class="io-off-lab">OFF</view>
        <view class="io-on-lab">ON</view>
      </view>
    </view>
    <view class="light-item">
      <view class="light-item-name">Reading Lights</view>
      <view class="{{readSwitchClass}}" bind:tap="toggleReading">
        <view class="io-thumb"></view>
        <view class="io-off-lab">OFF</view>
        <view class="io-on-lab">ON</view>
      </view>
    </view>
  </view>

  <view class="led-panel">
    <view class="led-title">Color Lights</view>
    <view
      id="spectrum"
      class="{{spectrumClass}}"
      bind:tap="onHueTap"
      bind:touchstart="onHueStart"
      catch:touchmove="onHueMove"
      bind:touchend="onHueEnd"
      bind:touchcancel="onHueEnd"
    >
      <view class="spectrum-ring"></view>
      <view class="spectrum-hole"></view>
      <view class="arm" style="transform: rotate({{hueDeg}}deg);">
        <view class="hue-knob" style="background-color: {{ledCss}};"></view>
      </view>
      <view
        class="led-orb"
        style="{{ledOrbStyle}}"
        catch:touchstart="onLedOrbTouch"
      ></view>
    </view>
  </view>

  <view class="{{shutdownClass}}" bind:tap="toggleSauna">{{shutdownLabel}}</view>
  </view>

  <view wx:if="{{navTab === 'health'}}" class="health">
    <view class="health-hero">
      <view class="heart heart-lg">
        <view class="heart-l"></view>
        <view class="heart-r"></view>
      </view>
      <text class="health-bpm">{{hrBpm}}</text>
      <text class="health-unit">BPM</text>
      <text class="health-status">{{hrStatus}}</text>
    </view>
    <view class="health-row">
      <view class="health-card health-card-wide">
        <text class="health-card-val">{{spo2}}</text>
        <text class="health-card-lab">Blood oxygen</text>
        <text class="health-card-sub">{{spo2Status}}</text>
      </view>
      <view class="health-card health-card-wide">
        <text class="health-card-val">{{kcalBurn}}</text>
        <text class="health-card-lab">Calories burned</text>
      </view>
    </view>
    <view class="health-panel health-runs">
      <text class="health-runs-val">{{healthSessions}}</text>
      <text class="health-runs-lab">Total sauna session runs</text>
    </view>
    <view class="health-panel">
      <view class="health-panel-title">Sauna health tips</view>
      <view wx:for="{{healthTips}}" wx:key="key" class="tip-row">
        <view class="tip-dot"></view>
        <text class="tip-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{navTab === 'schedule'}}" class="schedule">
    <view class="sound-title">Schedule sauna</view>
    <view wx:if="{{schedEmpty}}" class="health-panel">
      <view class="health-note">No schedules yet.</view>
    </view>
    <view
      wx:for="{{schedules}}"
      wx:key="id"
      class="sched-card"
      data-id="{{item.id}}"
      bind:tap="editSchedule"
    >
      <view class="sched-card-main">
        <view class="sched-card-time">{{item.rangeLabel}}</view>
        <view class="sched-card-sub">
          <view class="sched-card-tiny">{{item.detailLabel}}</view>
          <view class="sched-enable" data-id="{{item.id}}" catch:tap="toggleSchedule">
            <view class="sched-enable-lab">Enable</view>
            <view class="{{item.enableClass}}">
              <view class="io-thumb"></view>
              <view class="io-off-lab">OFF</view>
              <view class="io-on-lab">ON</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{!draftOpen}}" class="sched-add" bind:tap="addSchedule">Add schedule</view>
    <view wx:if="{{draftOpen}}" class="health-panel">
      <view class="sched-draft-title">{{draftTitle}}</view>
      <view class="sched-section sched-section-rule">
        <view class="sched-times">
          <view class="sched-time-col" data-field="on" bind:tap="openTimePopup">
            <view class="sched-time-lab">Turn on</view>
            <view class="sched-time-inline sched-time-on">{{draftOnLabel}}</view>
          </view>
          <view class="sched-time-col" data-field="off" bind:tap="openTimePopup">
            <view class="sched-time-lab">Turn off</view>
            <view class="sched-time-inline sched-time-off">{{draftOffLabel}}</view>
          </view>
        </view>
      </view>
      <view class="sched-section sched-section-rule">
        <view class="health-panel-title">Repeat pattern</view>
        <view class="sched-repeats">
          <view class="{{repeatOnceClass}}" data-repeat="once" bind:tap="setDraftRepeat">Once</view>
          <view class="{{repeatEveryClass}}" data-repeat="everyday" bind:tap="setDraftRepeat">Daily</view>
          <view class="{{repeatWeeklyClass}}" data-repeat="weekly" bind:tap="setDraftRepeat">Days</view>
        </view>
        <view wx:if="{{draftShowDays}}" class="sched-days">
          <view
            wx:for="{{draftDays}}"
            wx:key="key"
            class="{{item.dayClass}}"
            data-index="{{index}}"
            bind:tap="toggleDraftDay"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="sched-section">
        <view class="health-panel-title">Sauna settings</view>
        <view class="adjust-head">
          <view class="adjust-name">Heater temperature</view>
          <view class="adj-value">{{draftTempLabel}}</view>
        </view>
        <slider
          min="{{tempMin}}"
          max="{{tempMax}}"
          step="1"
          value="{{draftTempSlider}}"
          activeColor="#e31b23"
          backgroundColor="#1a3a52"
          block-size="28"
          bind:changing="onDraftTemp"
          bind:change="onDraftTemp"
        />
        <view class="sched-line sched-gap">
          <view class="light-item-name">Color Lights</view>
          <view class="{{draftLedClass}}" data-light="led" bind:tap="toggleDraftLight">
            <view class="io-thumb"></view>
            <view class="io-off-lab">OFF</view>
            <view class="io-on-lab">ON</view>
          </view>
        </view>
        <view class="sched-line sched-gap">
          <view class="light-item-name">Reading Lights</view>
          <view class="{{draftReadClass}}" data-light="read" bind:tap="toggleDraftLight">
            <view class="io-thumb"></view>
            <view class="io-off-lab">OFF</view>
            <view class="io-on-lab">ON</view>
          </view>
        </view>
        <view class="sched-line sched-gap">
          <view class="light-item-name">Salt Lights</view>
          <view class="{{draftSaltClass}}" data-light="salt" bind:tap="toggleDraftLight">
            <view class="io-thumb"></view>
            <view class="io-off-lab">OFF</view>
            <view class="io-on-lab">ON</view>
          </view>
        </view>
      </view>
      <view wx:if="{{draftError}}" class="sched-error">{{draftError}}</view>
      <view class="sched-actions">
        <view class="sched-cancel" bind:tap="cancelDraft">Cancel</view>
        <view wx:if="{{draftId}}" class="sched-del-btn" data-id="{{draftId}}" bind:tap="deleteSchedule">Remove</view>
        <view class="{{draftSaveClass}}" bind:tap="saveDraft">Save</view>
      </view>
    </view>
  </view>

  <view wx:if="{{navTab === 'sound'}}" class="sound">
    <view class="sound-title">Solfeggio Frequencies</view>
    <view class="sound-hero">
      <text class="sound-hz">{{toneHz}}</text>
      <text class="sound-unit">Hz</text>
      <text class="sound-name">{{toneName}}</text>
      <text class="sound-note">{{toneNote}}</text>
      <view class="{{tonePlayClass}}" bind:tap="toggleTone">{{tonePlayLabel}}</view>
    </view>
    <view class="health-panel">
      <view class="health-panel-title">Volume</view>
      <slider
        min="0"
        max="100"
        step="1"
        value="{{toneVol}}"
        activeColor="#d4a017"
        backgroundColor="#1a3a52"
        block-size="24"
        bind:changing="onToneVol"
        bind:change="onToneVol"
      />
    </view>
    <view
      wx:for="{{toneList}}"
      wx:key="hz"
      class="{{item.cardClass}}"
      data-hz="{{item.hz}}"
      bind:tap="selectTone"
    >
      <view class="tone-hz">{{item.hzLabel}}</view>
      <view class="tone-copy">
        <view class="tone-title">{{item.name}}</view>
        <view class="tone-sub">{{item.note}}</view>
      </view>
    </view>
  </view>
  </scroll-view>

  <view class="tabbar" style="height: {{tabbarHeight}}px; padding-bottom: {{safeBottom}}px;">
    <view class="{{saunaTabClass}}" data-tab="sauna" bind:tap="selectNav">
      <view class="tab-ring"></view>
      <text class="tab-text">Sauna</text>
    </view>
    <view class="{{scheduleTabClass}}" data-tab="schedule" bind:tap="selectNav">
      <view class="tab-clock">
        <view class="tab-clock-hand"></view>
      </view>
      <text class="tab-text">Schedule</text>
    </view>
    <view class="{{healthTabClass}}" data-tab="health" bind:tap="selectNav">
      <view class="heart heart-tab">
        <view class="heart-l"></view>
        <view class="heart-r"></view>
      </view>
      <text class="tab-text">Health</text>
    </view>
    <view class="{{soundTabClass}}" data-tab="sound" bind:tap="selectNav">
      <view class="tone-waves">
        <view class="tone-bar tone-bar-a"></view>
        <view class="tone-bar tone-bar-b"></view>
        <view class="tone-bar tone-bar-c"></view>
      </view>
      <text class="tab-text">Sound</text>
    </view>
  </view>

  <view wx:if="{{timePopupOpen}}" class="time-mask" catch:tap="noopTimeSheet">
    <view class="time-dialog" catch:tap="noopTimeSheet">
      <view class="time-sheet-title">{{timePopupTitle}}</view>
      <view class="time-sheet-value">{{popupLabel}}</view>
      <view class="time-wheel">
        <scroll-view scroll-y="{{true}}" class="time-col" scroll-into-view="{{popupHourId}}">
          <view
            wx:for="{{popupHours}}"
            wx:key="key"
            id="{{item.id}}"
            class="{{item.itemClass}}"
            data-part="hour"
            data-value="{{item.value}}"
            bind:tap="setPopupTimePart"
          >{{item.label}}</view>
        </scroll-view>
        <scroll-view scroll-y="{{true}}" class="time-col" scroll-into-view="{{popupMinId}}">
          <view
            wx:for="{{popupMins}}"
            wx:key="key"
            id="{{item.id}}"
            class="{{item.itemClass}}"
            data-part="min"
            data-value="{{item.value}}"
            bind:tap="setPopupTimePart"
          >{{item.label}}</view>
        </scroll-view>
        <scroll-view scroll-y="{{true}}" class="time-col" scroll-into-view="{{popupPeriodId}}">
          <view
            wx:for="{{popupPeriods}}"
            wx:key="key"
            id="{{item.id}}"
            class="{{item.itemClass}}"
            data-part="period"
            data-value="{{item.value}}"
            bind:tap="setPopupTimePart"
          >{{item.label}}</view>
        </scroll-view>
      </view>
      <view class="time-dialog-confirm" catch:tap="closeTimePopup">Confirm</view>
    </view>
  </view>
</view>
