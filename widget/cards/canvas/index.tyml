<view class="card-wrapper" bind:tap="openApp">
  <view class="title">{{I18n.t('hello')}}</view>
  <view class="time">{{statusLine}}</view>
  <view class="content">
    <view class="item border">
      <canvas
        style="height: 172rpx; width: 172rpx;"
        canvas-id="bu"
      ></canvas>
      <view class="unit">{{I18n.t('target')}}</view>
    </view>
    <view class="item">
      <canvas
        style="height: 172rpx; width: 172rpx;"
        canvas-id="kcal"
      ></canvas>
      <view class="unit">Heat</view>
    </view>
  </view>
  <view class="hint">Tap to open Sauna</view>
</view>
